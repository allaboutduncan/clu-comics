# Keep the build context to what the image runs. Without this file `COPY . .`
# ships the whole working directory -- including every agent worktree under
# .claude/worktrees (each a full copy of the repo), .git and the test suite --
# and the copy plus the layer export dominate the build.
#
# Only list things nothing reads at runtime. app-images/ (cbz_ops/add.py) and
# tools/ (repair_db.py) are needed and must stay out of this file.

# VCS, CI and agent state
.git
.github
.claude

# Caches and bytecode
.cache
.pytest_cache
.venv
**/__pycache__
**/*.pyc

# Tests
tests
requirements-test.txt

# Local runtime state: never bake a developer's database or logs into an image
logs
*.log
*.db
*.db-wal
*.db-shm
.env

# Build inputs and artefacts the container does not use
extension-builds
Dockerfile
.dockerignore
docker-compose.yaml
